rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn() && request.auth.token.admin == true;
    }

    function scorer() {
      return signedIn() && (request.auth.token.role == 'scorer' || admin());
    }

    function threadMember(threadId) {
      return signedIn() && exists(/databases/$(database)/documents/direct_chats/$(threadId))
        && request.auth.uid in get(/databases/$(database)/documents/direct_chats/$(threadId)).data.participants;
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if admin() || (signedIn() && request.auth.uid == uid);
    }

    match /live_matches/{matchId} {
      allow read: if true;
      allow create, update: if scorer();
      allow delete: if admin();

      match /deliveries/{deliveryId} {
        allow read: if true;
        allow create: if scorer()
          && request.resource.data.scorerUid == request.auth.uid;
        allow update, delete: if admin();
      }

      match /balls/{ballId} {
        allow read: if true;
        allow create: if scorer()
          && request.resource.data.scorerUid == request.auth.uid;
        allow update, delete: if admin();
      }
    }

    match /matches/{matchId}/live_chat/{messageId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.senderUid == request.auth.uid
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 500;
      allow delete: if admin() || (signedIn() && resource.data.senderUid == request.auth.uid);
      allow update: if false;
    }

    match /direct_chats/{threadId} {
      allow create: if signedIn()
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants;
      allow read, update: if threadMember(threadId) || admin();
      allow delete: if admin();

      match /messages/{messageId} {
        allow read: if threadMember(threadId) || admin();
        allow create: if threadMember(threadId)
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.recipientUid is string;
        allow delete: if admin() || (threadMember(threadId) && resource.data.senderUid == request.auth.uid);
        allow update: if false;
      }
    }

    match /role_requests/{requestId} {
      allow create: if signedIn() && request.resource.data.applicantUid == request.auth.uid;
      allow read: if admin() || (signedIn() && resource.data.applicantUid == request.auth.uid);
      allow update, delete: if admin();
    }
  }
}
